        "selector": "JSXOpeningElement[name.name='StatBlock'] > JSXAttribute[name.name='color'] > Literal[value!=/^(?:navy|cyan|violet|blue|white)$/]",
        "message": "<StatBlock> color must be one of 'navy' | 'cyan' | 'violet' | 'blue' | 'white'."
